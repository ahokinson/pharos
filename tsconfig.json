{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@adapters": ["src/adapters"],
      "@adapters/*": ["src/adapters/*"],
      "@color": ["src/color"],
      "@color/*": ["src/color/*"],
      "@config": ["src/config"],
      "@config/*": ["src/config/*"],
      "@metrics": ["src/metrics"],
      "@metrics/*": ["src/metrics/*"],
      "@plugin": ["src/plugin"],
      "@plugin/*": ["src/plugin/*"],
      "@process": ["src/process"],
      "@process/*": ["src/process/*"],
      "@render": ["src/render"],
      "@render/*": ["src/render/*"],
      "@session": ["src/session"],
      "@session/*": ["src/session/*"],
      "@tools": ["src/tools"],
      "@tools/*": ["src/tools/*"],
      "@tmux/*": ["src/tmux/*"],
      "@test": ["src/test"],
      "@test/*": ["src/test/*"]
    },

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  }
}
